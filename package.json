{
  "name": "retro-game-collector",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "backend": "node server/server.mjs",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "cap:sync": "npx cap sync",
    "cap:open:android": "npx cap open android",
    "cap:open:ios": "npx cap open ios",
    "catalog:generate": "powershell -ExecutionPolicy Bypass -File scripts/generate-retro-catalog.ps1",
    "catalog:generate-console": "powershell -ExecutionPolicy Bypass -File scripts/generate-console-catalog.ps1",
    "catalog:build-full": "node scripts/build-full-catalog.mjs",
    "catalog:build-lite": "node scripts/build-lite-catalog.mjs",
    "catalog:rebuild-index": "node scripts/rebuild-catalog-index.mjs",
    "catalog:enrich-years": "node scripts/enrich-retro-years.mjs",
    "marketing:calendar": "node scripts/generate-marketing-calendar.mjs",
    "outreach:run": "node scripts/outreach-runner.mjs",
    "outreach:night": "node scripts/outreach-runner.mjs --nightly",
    "outreach:prep": "node scripts/outreach-runner.mjs --nightly --open-all",
    "catalog:enrich-years:ps": "powershell -ExecutionPolicy Bypass -File scripts/enrich-retro-years.ps1",
    "load:test": "node scripts/load-test.mjs",
    "video:capture": "node video-generator/scripts/capture-site.js",
    "video:captions": "node video-generator/scripts/generate-captions.js",
    "video:generate": "node video-generator/scripts/generate-video.js",
    "video:demo": "node video-generator/scripts/generate-video.js --type full_youtube_demo",
    "video:short": "node video-generator/scripts/generate-video.js --type short_ad"
  },
  "devDependencies": {
    "ffmpeg-static": "^5.3.0",
    "playwright": "^1.59.1",
    "typescript": "~6.0.2",
    "vite": "^8.0.4"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.0",
    "@capacitor/cli": "^8.3.0",
    "@capacitor/core": "^8.3.0",
    "@capacitor/ios": "^8.3.0",
    "@capgo/capacitor-admob": "^8.1.1",
    "@zxing/browser": "^0.1.5"
  }
}
